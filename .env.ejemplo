# Ajustes de Jarvis. Copia este archivo como .env junto al programa (o como local.env en la carpeta
# local del equipo: Windows %LOCALAPPDATA%\Jarvis, Mac ~/Library/Application Support/Jarvis, Linux ~/.jarvis).
# Solo hace falta la clave de DeepSeek; lo demás es opcional.

# ---- IA (obligatorio) -------------------------------------------------------
DEEPSEEK_API_KEY=
# LIMITE_DIARIO_USD=0.50

# ---- Voz ----------------------------------------------------------------------
# PALABRA_CLAVE=jarvis
# VOZ=es-ES-AlvaroNeural
# VELOCIDAD_VOZ=+8%
# TRATAMIENTO=señor
# CIUDAD=Madrid
# ATAJO=ctrl+alt+j

# ---- Varios equipos (Jarvis compartido por Syncthing u otra carpeta sincronizada) ----
# EQUIPO=salon
# PRIORIDAD=2                      # el más alto encendido atiende Telegram, WhatsApp y avisos
# JARVIS_COMPARTIDA=/ruta/a/la/carpeta/compartida

# ---- MQTT (avisos entre equipos y sensores propios) -------------------------
# MQTT_HOST=127.0.0.1
# MQTT_PUERTO=1883
# MQTT_USUARIO=
# MQTT_CLAVE=
# MQTT_TEMAS=riego/#

# ---- Móvil --------------------------------------------------------------------
# El token del bot de Telegram va en la bóveda («Telegram bot»), no aquí.
# AVISOS_MOVIL=telegram,whatsapp
# WA_MODO=web                      # web = vinculado como WhatsApp Web · cloud = API de Meta
# WA_USUARIO=34600000000           # tu número, con prefijo y sin +: el único al que contesta

# ---- ESP32 / PlatformIO ---------------------------------------------------------
# PROYECTOS=/ruta/a/Proyectos;/otra/ruta

# ---- Teles LG webOS (nombre|IP|MAC|nombre en la bóveda; separadas por ;) ----
# TELES=salon|192.168.1.20|aa:bb:cc:dd:ee:ff|TV salon

# ---- Panel de estado (servidores por SSH: nombre=alias de ~/.ssh/config) ----
# PANEL_SERVIDORES=Servidor=mi-servidor
